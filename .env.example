# Local copy of your secrets. You normally never edit this by hand:
#   python -m bot auth <platform>   fills it in
#   python -m bot secrets           uploads it to GitHub Secrets
# The real file is called .env and is git-ignored. Never commit it.

TOKEN_STORE_KEY=

# Facebook + Instagram  (python -m bot auth meta)
META_APP_ID=
META_APP_SECRET=
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_TOKEN=
INSTAGRAM_USER_ID=

# Threads  (python -m bot auth threads)
THREADS_APP_ID=
THREADS_APP_SECRET=
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=

# YouTube  (python -m bot auth youtube)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# LinkedIn  (python -m bot auth linkedin)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_PERSON_URN=

# Pinterest  (python -m bot auth pinterest)
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
PINTEREST_REFRESH_TOKEN=
PINTEREST_BOARD_ID=

# Buffer: bridge for X and TikTok  (python -m bot auth buffer)
BUFFER_API_KEY=
BUFFER_CHANNEL_X=
BUFFER_CHANNEL_TIKTOK=

# Reddit  (python -m bot auth reddit), only after Reddit approves API access
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=
